{"name":"ohod-ai-platform","version":"1.0.0","description":"منصة ذكاء اصطناعي متكاملة","main":"server/index.js","scripts":{"dev":"concurrently \"npm run server:dev\" \"npm run client:dev\"","server:dev":"nodemon server/index.js","client:dev":"cd client && npm run dev","build":"cd client && npm run build","start":"node server/index.js","docker:build":"docker build -t ohod-ai:latest .","docker:run":"docker run -p 3000:3000 -p 5000:5000 ohod-ai:latest"},"dependencies":{"express":"^4.18.2","axios":"^1.6.2","dotenv":"^16.3.1","cors":"^2.8.5","helmet":"^7.1.0","express-ratelimit":"^7.1.5","jsonwebtoken":"^9.1.2","bcryptjs":"^2.4.3","express-validator":"^7.0.0","winston":"^3.11.0"},"devDependencies":{"nodemon":"^3.0.2","concurrently":"^8.2.2"}}